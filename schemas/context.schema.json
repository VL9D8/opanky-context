{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opanky:context:schema:1",
  "title": "OPANKY Public Context",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "context_id", "last_verified_at", "documents", "projects", "active_focus"],
  "properties": {
    "$schema": {"const": "schemas/context.schema.json"},
    "schema_version": {"const": 1},
    "context_id": {"const": "opanky-context"},
    "last_verified_at": {"type": "string", "format": "date"},
    "documents": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["document_id", "path", "description"], "properties": {"document_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "path": {"type": "string", "pattern": "^(README|CONTEXT|docs/[A-Z_]+)\\.md$"}, "description": {"type": "string", "minLength": 10, "maxLength": 240}}}},
    "projects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/project"}},
    "active_focus": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}}
  },
  "$defs": {
    "nullableUri": {"oneOf": [{"type": "string", "format": "uri", "pattern": "^https://"}, {"type": "null"}]},
    "project": {"type": "object", "additionalProperties": false, "required": ["project_id", "display_name", "project_type", "purpose", "owner", "parent_project_id", "portfolio_state", "revenue_horizon", "verification_status", "source_url", "evidence_url", "nearest_action", "last_verified_at"], "properties": {"project_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "display_name": {"type": "string", "minLength": 2, "maxLength": 80}, "project_type": {"enum": ["product", "commercial-cluster", "workflow", "client-project", "research"]}, "purpose": {"type": "string", "minLength": 20, "maxLength": 400}, "owner": {"type": "string", "minLength": 2, "maxLength": 80}, "parent_project_id": {"oneOf": [{"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, {"type": "null"}]}, "portfolio_state": {"enum": ["active", "next", "incubating", "paused", "archived"]}, "revenue_horizon": {"enum": ["immediate", "near", "indirect", "none"]}, "verification_status": {"enum": ["verified", "partial", "unverified", "stale"]}, "source_url": {"$ref": "#/$defs/nullableUri"}, "evidence_url": {"$ref": "#/$defs/nullableUri"}, "nearest_action": {"type": "string", "minLength": 10, "maxLength": 300}, "last_verified_at": {"type": "string", "format": "date"}}}
  }
}
